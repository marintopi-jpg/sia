# ── SIA Environment Configuration ──────────────────────────────────────────
# Copy this file to .env and adjust values before running docker compose up

# Application
APP_PORT=8080

# Database
DB_NAME=sia
DB_USER=sia_user
DB_PASS=sia_password
MYSQL_ROOT_PASSWORD=root_secret

# Auto-install DB schema on first container start (set false after first run)
SIA_AUTO_INSTALL=true

# Force regenerate Data.php (set true only to reset DB connection config)
FORCE_DATA_REGEN=false

# phpMyAdmin (only active with: docker compose --profile admin up)
PMA_PORT=8081
