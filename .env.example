# ─── Database Configuration ───────────────────────────────────────────────────
# MySQL root password (keep this secret in production)
MYSQL_ROOT_PASSWORD=root_secret_change_me

# Application database credentials
DB_NAME=sia
DB_USER=sia_user
DB_PASS=sia_password_change_me

# ─── Port Mapping ─────────────────────────────────────────────────────────────
# Port on your HOST machine where SIA will be accessible
APP_PORT=8080

# Port on your HOST machine for direct MySQL access (optional, remove for production)
DB_EXPOSE_PORT=3306

# phpMyAdmin port (only active with --profile admin)
PMA_PORT=8081

# ─── First-Run Options ───────────────────────────────────────────────────────
# Set to 'true' to auto-run SQL schema on empty database (new installs only)
SIA_AUTO_INSTALL=false

# Set to 'true' to force regeneration of Data.php from env vars
FORCE_DATA_REGEN=false
