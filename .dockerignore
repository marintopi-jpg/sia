# ─── Docker ignore ───────────────────────────────────────────────────────────
# Files/dirs excluded from the Docker build context (speeds up builds)

# Git
.git
.gitattributes
.gitignore

# Docker files themselves (not needed inside image)
.dockerignore
docker-compose.yml
docker-compose.override.yml

# Environment files (secrets)
.env
.env.*
!.env.example

# Runtime generated DB config (will be generated by entrypoint)
Data.php

# Docs & extras
docs/
*.md
!README.md

# Windows / OS artefacts
Thumbs.db
desktop.ini
.DS_Store

# IDE
.vscode/
.idea/
*.code-workspace

# Logs and temp
*.log
tmp/
